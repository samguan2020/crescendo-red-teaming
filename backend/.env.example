# --- Required ---
GOOGLE_API_KEY=your-gemini-key
HUGGINGFACE_API_KEY=your-hf-token
# Postgres is the source of truth. postgres:// or postgresql:// both work.
DATABASE_URL=postgresql://user:pass@localhost:5432/crescendo

# --- Storage / runtime ---
# Redis projection for fast polling. Required unless USE_MEMORY_STORE=true.
REDIS_URL=redis://localhost:6379
# Dev-only: skip Redis with an in-process dict (single process, lost on restart).
USE_MEMORY_STORE=false
# inprocess (default, single process) or arq (separate worker; run worker.WorkerSettings)
TASK_QUEUE=inprocess
JOB_TTL=86400

# --- Environment ---
# dev auto-creates the DB schema on startup; prod should run Alembic migrations.
ENV=dev

# --- API / CORS ---
# When set, every /api/v1/* call must send X-API-Key. Generate: openssl rand -hex 32
API_KEY=
ALLOWED_ORIGINS=["http://localhost:5173"]
ALLOWED_ORIGIN_REGEX=^https://.*\.vercel\.app$

# --- Optional overrides ---
GEMINI_MODEL=gemini-2.0-flash
DEFAULT_MAX_TURNS=10
